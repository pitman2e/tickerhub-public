# Shared defaults for the ci/build.*.sh scripts.
#
# This is a Docker Compose env file, not a shell script: it is read with
# `--env-file` and feeds `${VAR}` interpolation in the Compose YAML.
#
# Machine-specific overrides belong in ci/.env.dev (git-ignored). The build
# scripts pass it as a second --env-file, so it wins over this file.
#
# Keep values plain KEY=VALUE lines. Do not add `export`, and avoid shell
# syntax here.

# Host containers use to reach PostgreSQL. "pg_db" is the Docker service name
# used on the build server. A dev PC reaches the database through its IP
# address instead, via the git-ignored .env.dev override.
PG_HOST=pg_db
PG_PORT=5432

STOCKHUB_YFINANCE_GRPC=http://stockhub-yfinance-grpc:50051
