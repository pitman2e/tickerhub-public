{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch (UAT DB)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "gen-env-uat",
            "program": "${workspaceFolder}/backend/TickerHub.Api/bin/Debug/net10.0/StockHub.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/TickerHub.Api",
            "stopAtEntry": false,
            /* No need to open browser
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            */
            "envFile": "${workspaceFolder}/.vscode/.env.UAT.generated",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:4000",
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/backend/TickerHub.Api/Views"
            }
        },
        {
            "name": "Launch (PROD DB)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "gen-env-prod",
            "program": "${workspaceFolder}/backend/TickerHub.Api/bin/Debug/net10.0/StockHub.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/TickerHub.Api",
            "stopAtEntry": false,
            "envFile": "${workspaceFolder}/.vscode/.env.PROD.generated",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:4000",
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/backend/TickerHub.Api/Views"
            }
        },
        {
            "name": "Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Run npm start (Dev)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run start",
            "cwd": "${workspaceFolder}/frontend"
        },
        {
            "name": "Run npm start (Test)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run start:test",
            "cwd": "${workspaceFolder}/frontend"
        },
        {
            "name": "Run npm start (Web-Uat)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run start:web-uat",
            "cwd": "${workspaceFolder}/frontend"
        }
    ]
}